"""
LLM Smart Extractor — 自动从记忆中提取实体和关系

使用 MiniMax API 进行 LLM 驱动的实体和关系抽取。
集成到 hermes_memory provider 的 store() 流程中。

抽取结果格式:
{
    "entities": [
        {"name": "城哥", "type": "person"},
        {"name": "记忆系统", "type": "concept"},
    ],
    "triples": [
        {"subject": "城哥", "predicate": "uses", "object": "记忆系统", "confidence": 0.9},
    ]
}
"""

from __future__ import annotations

import json
import logging
import os
import re
import threading
import time
import urllib.request
from dataclasses import dataclass
from typing import Any, Dict, List, Optional

logger = logging.getLogger(__name__)

# =============================================================================
# Configuration
# =============================================================================

# MiniMax API configuration (from environment or config)
_MINIMAX_API_KEY: Optional[str] = None
_MINIMAX_BASE_URL: str = "https://api.minimaxi.com/v1"
_MINIMAX_MODEL: str = "MiniMax-M2.7-highspeed"

# Extraction settings
_EXTRACTION_ENABLED: bool = True
_EXTRACTION_THRESHOLD: float = 0.3  # Skip extraction for texts shorter than this
_EXTRACTION_TIMEOUT: int = 30  # seconds

# Regex fallback patterns (used if LLM extraction fails)
_FALLBACK_PATTERNS: List[tuple] = [
    (r"(.+?) is (.+)", "is"),
    (r"(.+?) likes (.+)", "likes"),
    (r"(.+?) prefers (.+)", "prefers"),
    (r"(.+?) lives in (.+)", "lives_in"),
    (r"(.+?) works at (.+)", "works_at"),
    (r"(.+?) works on (.+)", "works_on"),
    (r"(.+?) uses (.+)", "uses"),
    (r"(.+?) created (.+)", "created"),
    (r"(.+?) owns (.+)", "owns"),
    (r"(.+?) told (.+?) to (.+)", "told"),
    (r"(.+?) asked (.+?) to (.+)", "asked"),
    (r"(.+?) wants (.+)", "wants"),
    (r"(.+?) developing (.+)", "developing"),
    # Chinese patterns — limit match length to avoid capturing whole paragraphs
    (r"([^。，\n]{2,20})让我([^。，\n]{2,30})", "told_me"),      # X让我Y
    (r"([^。，\n]{2,20})正在([^。，\n]{2,30})", "doing"),         # X正在Y
    (r"([^。，\n]{2,20})说([^。，\n]{2,30})", "said"),           # X说Y
    (r"([^。，\n]{2,20})用([^。，\n]{2,30})", "uses"),           # X用Y
    (r"([^。，\n]{2,20})开发([^。，\n]{2,30})", "developing"),   # X开发Y
    (r"([^。，\n]{2,20})修复([^。，\n]{2,30})", "fixing"),       # X修复Y
]

# Entity types for disambiguation
_ENTITY_TYPES: List[str] = [
    "person", "agent", "concept", "project", "system",
    "tool", "file", "concept", "preference", "skill"
]


def _get_api_key() -> Optional[str]:
    """Get MiniMax API key from environment or config."""
    global _MINIMAX_API_KEY
    if _MINIMAX_API_KEY:
        return _MINIMAX_API_KEY

    # Try environment variable
    key = os.environ.get("MINIMAX_CN_API_KEY", "")
    if key:
        _MINIMAX_API_KEY = key
        return key

    # Try .env file
    env_path = os.path.expanduser("~/.hermes/.env")
    if os.path.exists(env_path):
        with open(env_path) as f:
            for line in f:
                if "MINIMAX_CN_API_KEY" in line:
                    key = line.split("=", 1)[1].strip()
                    _MINIMAX_API_KEY = key
                    return key
    return None


@dataclass
class ExtractionResult:
    """LLM extraction result."""
    entities: List[Dict[str, str]]  # [{"name": "...", "type": "..."}]
    triples: List[Dict[str, Any]]   # [{"subject": "...", "predicate": "...", "object": "...", "confidence": 0.9}]
    method: str  # "llm" or "regex"


def extract_with_llm(text: str, timeout: int = _EXTRACTION_TIMEOUT) -> Optional[ExtractionResult]:
    """
    使用 MiniMax API 从文本中提取实体和关系。

    Args:
        text: 输入文本
        timeout: API 超时时间（秒）

    Returns:
        ExtractionResult 或 None（如果提取失败）
    """
    api_key = _get_api_key()
    if not api_key:
        logger.debug("No MiniMax API key available for LLM extraction")
        return None

    # Skip very short texts
    if len(text) < 50:
        logger.debug("Text too short for LLM extraction (%d chars)", len(text))
        return None

    # Build prompt
    prompt = f"""从文本中提取实体（人名、项目、系统、概念等）和关系（主体-谓词-客体），用英文谓词。

实体type可选：person, agent, concept, project, system, tool, file, preference, skill
谓词用英文：knows, uses, works_on, created, told, asked, developing, owns, related_to

文本：
{text[:1500]}

直接输出JSON（不输出其他内容）：
{{"entities":[{{"name":"城哥","type":"person"}}],"triples":[{{"subject":"城哥","predicate":"developing","object":"小说写作项目","confidence":0.9}}]}}
"""

    payload = {
        "model": _MINIMAX_MODEL,
        "messages": [
            {"role": "user", "content": prompt}
        ],
        "max_tokens": 500,
        "temperature": 0.1,  # Low temperature for extraction
    }

    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json",
    }

    url = f"{_MINIMAX_BASE_URL}/chat/completions"
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers=headers)

    try:
        resp = urllib.request.urlopen(req, timeout=timeout)
        result = json.loads(resp.read().decode("utf-8"))
        content = result["choices"][0]["message"]["content"]

        # Parse JSON from response
        content = content.strip()

        # CRITICAL FIX: Strip <think>...</think> wrappers from reasoning models
        # before attempting JSON extraction. Some models (e.g. DeepSeek-R1,
        # Kimi-K2.6-thinking) wrap their reasoning in <think> tags.
        think_match = re.search(r'<think>.*?</think>', content, re.DOTALL)
        if think_match:
            content = content[think_match.end():].strip()

        json_str = None
        parse_error = None

        # Strategy 1: JSON code block: ```json ... ```
        json_match = re.search(r'```json\s*(.*?)\s*```', content, re.DOTALL)
        if json_match:
            json_str = json_match.group(1).strip()

        # Strategy 2: Plain JSON — find first `{` and try to parse
        # Only use this if strategy 1 didn't work
        if not json_str:
            first_brace = content.find('{')
            if first_brace != -1:
                # Try progressively larger slices to find valid JSON
                for end_offset in range(50, len(content) - first_brace + 1):
                    candidate = content[first_brace:first_brace + end_offset]
                    try:
                        parsed = json.loads(candidate)
                        # Check if it has expected structure
                        if isinstance(parsed, dict) and ("entities" in parsed or "triples" in parsed):
                            json_str = candidate
                            break
                    except json.JSONDecodeError:
                        continue

        # Strategy 3: Fallback — find last `}` and try from first `{`
        if not json_str:
            last_brace = content.rfind('}')
            if first_brace != -1 and last_brace > first_brace:
                json_str = content[first_brace:last_brace + 1]
                try:
                    parsed = json.loads(json_str)
                except json.JSONDecodeError as e:
                    parse_error = str(e)
                    json_str = None

        if not json_str:
            logger.warning("Could not parse JSON from LLM response. Error: %s. Content preview: %s",
                         parse_error or "unknown", content[:200])
            return None

        parsed = json.loads(json_str)

        entities = parsed.get("entities", [])
        triples = parsed.get("triples", [])

        # Validate and clean
        valid_entities = []
        seen_names = set()
        for e in entities:
            name = str(e.get("name", "")).strip()
            etype = str(e.get("type", "concept")).strip()
            if name and len(name) > 1 and name not in seen_names:
                seen_names.add(name)
                # Validate entity type
                if etype not in _ENTITY_TYPES:
                    etype = "concept"
                valid_entities.append({"name": name, "type": etype})

        valid_triples = []
        for t in triples:
            s = str(t.get("subject", "")).strip()
            p = str(t.get("predicate", "")).strip()
            o = str(t.get("object", "")).strip()
            conf = float(t.get("confidence", 0.8))
            if s and p and o and len(s) > 1 and len(o) > 1:
                valid_triples.append({
                    "subject": s,
                    "predicate": p,
                    "object": o,
                    "confidence": min(1.0, max(0.5, conf)),
                })

        return ExtractionResult(
            entities=valid_entities,
            triples=valid_triples,
            method="llm",
        )

    except Exception as e:
        logger.warning("LLM extraction failed: %s: %s", type(e).__name__, str(e)[:100])
        return None


def extract_with_regex(text: str) -> ExtractionResult:
    """
    使用正则表达式从文本中提取实体和关系（fallback）。

    Returns:
        ExtractionResult
    """
    entities: List[Dict[str, str]] = []
    triples: List[Dict[str, Any]] = []
    seen_entities: set = set()
    seen_triples: set = set()

    for pattern, predicate in _FALLBACK_PATTERNS:
        try:
            for match in re.finditer(pattern, text, re.IGNORECASE):
                groups = match.groups()
                if len(groups) >= 2:
                    subject = groups[0].strip()
                    obj = " ".join(str(g).strip() for g in groups[1:])

                    if len(subject) < 2 or len(obj) < 2:
                        continue

                    # Add entity
                    if subject not in seen_entities:
                        seen_entities.add(subject)
                        # Heuristic type detection
                        etype = _infer_entity_type(subject)
                        entities.append({"name": subject, "type": etype})

                    # Add triple
                    triple_key = (subject, predicate, obj)
                    if triple_key not in seen_triples:
                        seen_triples.add(triple_key)
                        triples.append({
                            "subject": subject,
                            "predicate": predicate,
                            "object": obj,
                            "confidence": 0.7,
                        })

                    # Also add object as entity
                    if obj not in seen_entities:
                        seen_entities.add(obj)
                        etype = _infer_entity_type(obj)
                        entities.append({"name": obj, "type": etype})

        except re.error:
            continue

    return ExtractionResult(entities=entities, triples=triples, method="regex")


def _infer_entity_type(name: str) -> str:
    """Infer entity type from name heuristics."""
    name_lower = name.lower()

    # Person indicators
    person_indicators = ["我", "城哥", "mars", "chen", "ying", "wei", "老板", "他", "她"]
    for indicator in person_indicators:
        if indicator.lower() in name_lower:
            return "person"

    # Project indicators
    project_indicators = ["项目", "project", "小说", "写作", "novel", "writing"]
    for indicator in project_indicators:
        if indicator.lower() in name_lower:
            return "project"

    # System/tool indicators
    system_indicators = ["系统", "system", "记忆", "memory", "agent", "bot", "tool"]
    for indicator in system_indicators:
        if indicator.lower() in name_lower:
            return "system"

    # Concept
    concept_indicators = ["概念", "concept", "idea", "计划", "plan"]
    for indicator in concept_indicators:
        if indicator.lower() in name_lower:
            return "concept"

    # File indicators
    file_indicators = [".py", ".md", ".json", ".yaml", ".txt", ".js"]
    for indicator in file_indicators:
        if indicator.lower() in name_lower:
            return "file"

    return "concept"


def smart_extract(text: str) -> ExtractionResult:
    """
    从文本中提取实体和关系。

    先尝试 LLM 提取，失败则降级到正则表达式。

    Args:
        text: 输入文本

    Returns:
        ExtractionResult
    """
    if not _EXTRACTION_ENABLED:
        return extract_with_regex(text)

    # Try LLM extraction first
    result = extract_with_llm(text)
    if result and (result.entities or result.triples):
        logger.debug("LLM extraction: %d entities, %d triples",
                    len(result.entities), len(result.triples))
        return result

    # Fallback to regex
    result = extract_with_regex(text)
    if result.entities or result.triples:
        logger.debug("Regex extraction: %d entities, %d triples",
                    len(result.entities), len(result.triples))
    return result


# =============================================================================
# Background extraction runner
# =============================================================================

# Background thread for non-blocking extraction
from collections import deque
# OPTIMIZATION: Hard cap on queue size to prevent OOM during bulk imports.
# When the queue is full, new extractions are dropped (KG extraction is
# best-effort background work, not critical path).
_EXTRACTION_QUEUE_MAX = 200
_extraction_lock = threading.Lock()
_extraction_queue: deque = deque(maxlen=_EXTRACTION_QUEUE_MAX)  # auto-discard oldest when full
_extraction_thread: Optional[threading.Thread] = None
_extraction_running = False


def _extraction_worker() -> None:
    """Background worker that processes extraction queue."""
    global _extraction_running

    while _extraction_running:
        item = None
        with _extraction_lock:
            if _extraction_queue:
                item = _extraction_queue.popleft()

        if item is None:
            time.sleep(1)
            continue

        text, memory_id, stored_id = item

        try:
            result = smart_extract(text)
            if not result:
                continue

            # Import here to avoid circular dependency
            from .kg_integration import add_triple_with_entity

            for entity_dict in result.entities:
                logger.debug("Entity: %s (%s)", entity_dict["name"], entity_dict["type"])

            for triple_dict in result.triples:
                try:
                    add_triple_with_entity(
                        subject=triple_dict["subject"],
                        predicate=triple_dict["predicate"],
                        obj=triple_dict["object"],
                        confidence=triple_dict.get("confidence", 0.8),
                        subject_type=next(
                            (e["type"] for e in result.entities if e["name"] == triple_dict["subject"]),
                            "concept"
                        ),
                        object_type=next(
                            (e["type"] for e in result.entities if e["name"] == triple_dict["object"]),
                            "concept"
                        ),
                        context=f"memory_id:{memory_id}",
                        source="smart-extractor",
                    )
                    logger.debug("Added triple: %s --[%s]--> %s",
                               triple_dict["subject"], triple_dict["predicate"], triple_dict["object"])
                except Exception as e:
                    logger.warning("Failed to add triple: %s", e)

        except Exception as e:
            logger.warning("Extraction worker error: %s", e)


def queue_extraction(text: str, memory_id: str, stored_id: str) -> None:
    """
    将记忆加入后台提取队列（非阻塞）。

    Args:
        text: 记忆文本
        memory_id: 用于 context 引用
        stored_id: LanceDB 存储的记录 ID
    """
    global _extraction_thread, _extraction_running

    if not _EXTRACTION_ENABLED:
        return

    with _extraction_lock:
        # deque maxlen auto-discards oldest when full
        _extraction_queue.append((text, memory_id, stored_id))

        # Start background thread if not running
        if _extraction_thread is None or not _extraction_thread.is_alive():
            _extraction_running = True
            _extraction_thread = threading.Thread(target=_extraction_worker, daemon=True)
            _extraction_thread.start()


def stop_extraction() -> None:
    """Stop the background extraction thread."""
    global _extraction_running
    _extraction_running = False
